# Copy to .env and fill in real values before deploying anywhere public.

# REQUIRED: absolute host path where every student's private folder lives.
# Must NOT be a relative path -- the api container talks to the HOST Docker
# daemon over a socket, and any bind-mount path it asks the daemon to use
# is resolved on the HOST filesystem, not inside any container. Run:
#   mkdir -p ~/learn-git/students-data
# then set the FULL absolute path here, e.g.:
STUDENTS_HOST_PATH=/absolute/path/to/learn-git/students-data

# Long random string used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated registration numbers that get admin rights on first sign-up.
# Example: ADMIN_REG_NOS=21CS001,21CS002
ADMIN_REG_NOS=

# Restrict CORS to your real frontend origin in production, e.g.:
#   CORS_ORIGIN=https://learn-git.example.com
CORS_ORIGIN=*

# Set to "true" once you're serving over HTTPS (required for secure cookies)
COOKIE_SECURE=false

# Number of gunicorn worker processes for the api. Bump this on a bigger
# instance if you're serving many concurrent students. Default is fine
# for a normal classroom size.
WEB_CONCURRENCY=4

# Hours a student's workspace container can sit idle (no dashboard load,
# no terminal activity) before it's automatically stopped to reclaim
# resources. Their repo data is untouched -- it starts fresh again next
# time they log in. Default is fine for most classroom use.
IDLE_WORKSPACE_HOURS=24
